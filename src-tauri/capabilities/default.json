{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认权限",
  "windows": ["main", "pet"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-ignore-cursor-events",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
