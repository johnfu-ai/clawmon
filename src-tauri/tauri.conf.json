{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clawmon",
  "version": "0.2.0",
  "identifier": "com.statebar.clawmon",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude WSL 监控",
        "width": 400,
        "height": 620,
        "minWidth": 340,
        "minHeight": 420,
        "resizable": true,
        "center": true
      },
      {
        "label": "pet",
        "title": "clawmon pet",
        "url": "pet.html",
        "width": 110,
        "height": 110,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
